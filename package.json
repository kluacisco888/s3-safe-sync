{
  "name": "s3-vault-sync",
  "version": "0.1.0",
  "description": "Synchronize Obsidian Vault files through Amazon S3 with end-to-end encryption and deletion-safe history.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/aws-live.integration.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "s3",
    "sync"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kluacisco888/s3-safe-sync.git"
  },
  "bugs": {
    "url": "https://github.com/kluacisco888/s3-safe-sync/issues"
  },
  "homepage": "https://github.com/kluacisco888/s3-safe-sync#readme",
  "dependencies": {
    "@aws-crypto/sha256-browser": "^5.2.0",
    "@fyears/rclone-crypt": "0.0.7",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "fast-xml-parser": "^5.11.1",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "3.2.7"
  }
}
